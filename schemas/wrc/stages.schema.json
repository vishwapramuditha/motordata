{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WRC Stages Schema",
  "type": "object",
  "properties": {
    "rallyId": {
      "type": "string"
    },
    "season": {
      "type": "integer"
    },
    "stageNumber": {
      "type": "integer"
    },
    "stageName": {
      "type": "string"
    },
    "distanceKm": {
      "type": "number"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "position": {
            "type": "integer",
            "minimum": 1
          },
          "driverId": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "stageTime": {
            "type": "string"
          },
          "overallTime": {
            "type": "string"
          }
        },
        "required": ["position", "driverId", "stageTime", "overallTime"],
        "additionalProperties": false
      }
    }
  },
  "required": ["rallyId", "season", "stageNumber", "stageName", "distanceKm", "results"],
  "additionalProperties": false
}
